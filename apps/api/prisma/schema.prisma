// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Papel da conta (ARQ-04): o banco recusa qualquer outro valor.
enum Role {
  USER
  ADMIN
  EMPLOYEE
}

model User {
  id                String    @id @default(cuid())
  name              String
  /// Vazio só no "cliente rápido" que a recepção cadastra por telefone (UX-03).
  email             String?   @unique
  /// Vazia enquanto a conta não foi ativada: ninguém entra nela até criar a senha pelo link.
  password          String?
  phone             String?
  avatar            String?
  role              Role      @default(USER)
  active            Boolean   @default(true)
  /// Preenchido quando o dono confirma o e-mail pelo link. Sem ele, o cliente não reserva.
  emailVerifiedAt   DateTime?
  passwordChangedAt DateTime?
  tokenVersion      Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  appointments        Appointment[]
  employee            Employee?
  passwordResetTokens PasswordResetToken[]
  emailChangeTokens   EmailChangeToken[]
  statusChanges       AppointmentStatusChange[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailChangeToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("email_change_tokens")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  duration    Int // duração em minutos
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees    EmployeeProduct[]
  appointments Appointment[]

  @@map("products")
}

model Employee {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  phone         String?
  avatar        String?
  active        Boolean  @default(true)
  /// Respiro, em minutos, entre dois atendimentos deste profissional (UX-12).
  bufferMinutes Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  products      EmployeeProduct[]
  appointments  Appointment[]
  businessHours EmployeeBusinessHour[]
  specialDays   EmployeeSpecialDay[]
  invites       EmployeeInvite[]

  @@map("employees")
}

/// Convite para o profissional ligar a própria conta ao cadastro (SEC-03). O vínculo só acontece
/// quando quem recebeu o e-mail aceita; criar o profissional não promove nenhuma conta sozinho.
model EmployeeInvite {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([employeeId, usedAt])
  @@index([expiresAt])
  @@map("employee_invites")
}

model EmployeeProduct {
  employeeId String
  productId  String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([employeeId, productId])
  @@map("employee_products")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id      String            @id @default(cuid())
  date    DateTime // data e hora do início
  endDate DateTime // data e hora do fim (calculado: date + product.duration)
  status  AppointmentStatus @default(SCHEDULED)
  notes   String?
  price   Decimal           @db.Decimal(10, 2) // preço no momento do agendamento

  clientId String
  client   User   @relation(fields: [clientId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusChanges AppointmentStatusChange[]

  @@index([employeeId, date])
  @@index([clientId])
  @@index([date])
  @@map("appointments")
}

/// Histórico das mudanças de status (DOM-01): quem mudou, de onde para onde e por quê. Também é
/// a base do "Desfazer": a última mudança, feita há pouco pela mesma pessoa, pode ser revertida.
model AppointmentStatusChange {
  id            String            @id @default(cuid())
  appointmentId String
  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  fromStatus    AppointmentStatus
  toStatus      AppointmentStatus
  /// ADMIN, EMPLOYEE ou CLIENT.
  actorRole     String
  actorId       String?
  actor         User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)
  reason        String?
  revertedAt    DateTime?
  createdAt     DateTime          @default(now())

  @@index([appointmentId, createdAt])
  @@index([actorId])
  @@map("appointment_status_changes")
}

model BusinessHour {
  id        String  @id @default(cuid())
  dayOfWeek Int // 0 = Domingo, 1 = Segunda, ..., 6 = Sábado
  openTime  String // formato "HH:mm" ex: "08:00"
  closeTime String // formato "HH:mm" ex: "18:00"
  isClosed  Boolean @default(false)
  /// Pausas do dia (UX-12), ex.: almoço. Lista de `{ "start": "12:00", "end": "13:00" }`.
  breaks    Json    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek])
  @@map("business_hours")
}

model SpecialDay {
  id          String   @id @default(cuid())
  date        DateTime @db.Date // apenas a data, sem hora
  title       String // ex: "Natal", "Carnaval"
  description String?
  isClosed    Boolean  @default(true)
  openTime    String? // horário especial de abertura (se isClosed = false)
  closeTime   String? // horário especial de fechamento (se isClosed = false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
  @@map("special_days")
}

model EmployeeBusinessHour {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  openTime   String
  closeTime  String
  isClosed   Boolean  @default(false)
  /// Pausas do profissional neste dia (UX-12), no mesmo formato do estúdio.
  breaks     Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, dayOfWeek])
  @@index([employeeId])
  @@map("employee_business_hours")
}

model EmployeeSpecialDay {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  title       String
  description String?
  isClosed    Boolean  @default(true)
  openTime    String?
  closeTime   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@map("employee_special_days")
}

enum EmailOutboxStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Fila de e-mails (ARQ-02). A API grava aqui e um worker envia pelo Resend, com nova tentativa.
/// `runAt` no futuro agenda o envio (lembretes). O conteúdo (`payload`) é apagado quando o e-mail
/// sai, é ignorado ou, nos que levam link de uso único, quando a fila desiste.
model EmailOutbox {
  id             String            @id @default(cuid())
  type           String
  recipient      String
  idempotencyKey String            @unique
  payload        Json
  status         EmailOutboxStatus @default(PENDING)
  attempts       Int               @default(0)
  maxAttempts    Int               @default(6)
  runAt          DateTime          @default(now())
  lockedAt       DateTime?
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, runAt])
  @@map("email_outbox")
}

/// Contadores de rate limit e bloqueio de login (SEC-08). A API conta em memória e grava aqui a
/// cada poucos segundos, para a contagem sobreviver a um deploy ou restart.
model RateLimitEntry {
  key       String   @id
  /// `bucket` (janela deslizante) ou `login` (bloqueio por e-mail + IP).
  kind      String
  data      Json
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("rate_limit_entries")
}

// Comando migrate
// npx prisma migrate dev --name init
