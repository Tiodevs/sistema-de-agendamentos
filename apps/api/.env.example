# Prisma + PostgreSQL
# Local com Railway: rode `npm run db:tunnel` e use o túnel em 127.0.0.1:5433
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5433/railway"

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET="your-secret-key-here"
JWT_EXPIRES_IN="7d"

# Resend (e-mail transacional)
RESEND_API_KEY="re_xxxxxxxxx"
EMAIL_FROM="Leemia <agendamentos@mefelipe.com.br>"
APP_URL="http://localhost:3000"
EMAIL_ASSET_BASE_URL="https://agendamento.mefelipe.com.br"

# Railway Storage Bucket (fotos de perfil)
S3_ENDPOINT="https://t3.storageapi.dev"
S3_REGION="auto"
S3_BUCKET="fotos-xxxxxxxxxxxxxxxxxxxx"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
