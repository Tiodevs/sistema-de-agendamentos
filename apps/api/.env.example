# API fora do Docker. Para desenvolver, prefira o ambiente Docker da raiz (README): ele tem
# Postgres próprio e não precisa de nenhuma credencial de produção.

# Prisma + PostgreSQL
# Postgres do Docker (docker compose up -d db): usuário, senha e banco do .env da raiz.
DATABASE_URL="postgresql://agendamentos:troque-pela-POSTGRES_PASSWORD@127.0.0.1:5434/agendamentos"
# Túnel do Railway (npm run db:tunnel, 127.0.0.1:5433) = banco de PRODUÇÃO. Seed e E2E se recusam
# a rodar nele; use só para consultar, com cuidado.

# Server
PORT=3001
NODE_ENV=development

# JWT (obrigatório; a API não sobe sem isso)
JWT_SECRET="your-secret-key-here"
JWT_EXPIRES_IN="12h"

# Quantos proxies existem entre o cliente e a API (SEC-08). O IP do rate limit e do bloqueio de
# login sai daqui: com um número menor que o real, todos os clientes parecem o mesmo IP; com um
# maior, o cliente forja X-Forwarded-For. Sem a variável, produção assume 1 (o proxy do Railway)
# e dev assume nenhum. Se a API passar a ficar atrás do rewrite do Next (Vercel), são 2.
# TRUST_PROXY="1"

# Origens permitidas no CORS (separadas por vírgula). Padrão: APP_URL.
CORS_ORIGINS="http://localhost:3000"

# Multiplica os limites por IP (login, cadastro, recuperação). Só a CI usa (10). Não defina em produção.
# RATE_LIMIT_IP_FACTOR="1"

# Swagger em produção fica desligado, a menos que SWAGGER_ENABLED=true
# SWAGGER_ENABLED="true"
# URL pública desta API, listada no Swagger e usada nos links das fotos. No Railway, sem ela, vale
# o domínio de RAILWAY_PUBLIC_DOMAIN.
# PUBLIC_API_URL="http://localhost:3001"

# Log (pino). Nível: fatal, error, warn, info (padrão), debug, trace ou silent. Em dev o log sai
# legível; LOG_PRETTY="false" força JSON, como em produção.
# LOG_LEVEL="info"
# LOG_PRETTY="false"

# Sentry (opcional). Vazio, nenhum erro é enviado. Só erros 5xx e e-mails que a fila desistiu de
# enviar; sem tracing e sem dados de cliente.
# SENTRY_DSN=""
# SENTRY_ENVIRONMENT="production"

# Antecedência mínima (em horas) para o cliente cancelar sozinho e o profissional cancelar pelo
# painel. Depois do prazo, só o admin cancela. Padrão: 2. Aceita fração (0.5 = 30 min).
# CANCELLATION_NOTICE_HOURS="2"

# Resend (e-mail transacional). Vazio, o e-mail entra na fila (email_outbox) e é marcado como
# ignorado, sem envio. Com a chave, a fila tenta de novo quando o Resend falha.
RESEND_API_KEY=""
EMAIL_FROM="Leemia <agendamentos@mefelipe.com.br>"
APP_URL="http://localhost:3000"
EMAIL_ASSET_BASE_URL="https://agendamento.mefelipe.com.br"

# Railway Storage Bucket (fotos de perfil). Vazio, o upload responde 503.
# No Railway: S3_ENDPOINT="https://t3.storageapi.dev" e S3_BUCKET="fotos-…".
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Seed (npm run db:seed): senha das contas fictícias. Vazia, o seed sorteia uma.
# SEED_PASSWORD=""
