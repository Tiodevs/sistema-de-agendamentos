{
  "name": "agendamentos",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de agendamentos - Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names \"API,WEB\" --prefix-colors \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "start": "concurrently --names \"API,WEB\" --prefix-colors \"blue,green\" \"npm run start:api\" \"npm run start:web\"",
    "start:api": "npm run start --workspace=apps/api",
    "start:web": "npm run start --workspace=apps/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:api": "eslint apps/api",
    "lint:web": "eslint apps/web",
    "typecheck": "tsc --noEmit -p apps/api && tsc --noEmit -p apps/web",
    "db:tunnel": "railway connect Postgres --tunnel-only --port 5433",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "test": "node scripts/run-node-tests.mjs apps/api/test apps/web/test",
    "test:e2e": "playwright test --grep-invert @gap",
    "test:e2e:auth": "playwright test auth.api auth-security.api auth-ui --grep-invert @gap",
    "test:e2e:gaps": "playwright test --grep @gap",
    "test:e2e:all": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/.next apps/*/dist packages/*/node_modules",
    "prepare": "husky || true",
    "test:api": "npm run test --workspace=apps/api",
    "test:web": "npm run test --workspace=apps/web"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.51.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.72.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,cjs,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "postcss": "^8.5.32"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
