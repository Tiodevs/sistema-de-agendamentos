# Variáveis do docker compose (ambiente Docker local, isolado da produção).
# Copie para .env aqui na raiz e preencha. Para gerar um valor aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A API fora do Docker continua usando apps/api/.env.

# Obrigatórias. A senha entra na DATABASE_URL: use só letras e números.
POSTGRES_PASSWORD=
JWT_SECRET=

# Portas no host (opcionais).
# WEB_PORT=3000
# API_PORT=3001
# POSTGRES_PORT=5434

# Senha das contas fictícias do seed (admin@leemia.dev, cliente@leemia.dev, profissionais).
# Vazia, o seed sorteia uma a cada execução e mostra no fim. Os testes E2E também a usam.
# SEED_PASSWORD=

# Integrações (opcionais). Vazias, e-mail só vai para o log da API e upload de foto responde 503.
# RESEND_API_KEY=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
